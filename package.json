{
  "name": "@pablozaiden/listen",
  "description": "Single-user, passkey-protected web notification inbox for Docker",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun src/build.ts",
    "test": "bun scripts/run-tests.ts all",
    "seed:demo": "bun scripts/seed-demo-data.ts",
    "test:backend": "bun scripts/run-tests.ts backend",
    "test:frontend": "bun scripts/run-tests.ts frontend",
    "tsc": "mkdir -p .cache/tsc && bunx tsc --noEmit --pretty false --incremental --tsBuildInfoFile .cache/tsc/build.tsbuildinfo"
  },
  "dependencies": {
    "@pablozaiden/webapp": "github:PabloZaiden/webapp#1edfbc32b3fe24b89476d2b1532e502755ff129d",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@simplewebauthn/server": "14.0.3",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
