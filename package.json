{
  "name": "@pablozaiden/listen",
  "description": "Single-user passkey-protected notification inbox for agents and webhooks",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:listen",
    "dev:listen": "LISTEN_DATA_DIR=apps/listen/data bun --hot apps/listen/src/index.ts serve",
    "start": "bun run start:listen",
    "start:listen": "NODE_ENV=production bun apps/listen/src/index.ts serve",
    "build": "bun scripts/run-build.ts",
    "build:workspaces": "bun scripts/run-workspace-script.ts build",
    "test": "bun scripts/run-tests.ts all",
    "test:backend": "bun scripts/run-tests.ts backend",
    "test:frontend": "bun scripts/run-tests.ts frontend",
    "tsc": "mkdir -p .cache/tsc && bunx tsc --noEmit --pretty false --incremental --tsBuildInfoFile .cache/tsc/build.tsbuildinfo",
    "tsc:workspaces": "bun scripts/run-workspace-script.ts build"
  },
  "dependencies": {
    "@pablozaiden/installer": "latest",
    "@simplewebauthn/browser": "latest",
    "@simplewebauthn/server": "latest",
    "@tailwindcss/typography": "latest",
    "bun-plugin-tailwind": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "tailwindcss": "latest",
    "tslog": "latest",
    "web-push": "^3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "^3.6.4",
    "typescript": "latest"
  }
}
